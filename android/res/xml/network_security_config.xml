<?xml version="1.0" encoding="utf-8"?>
<!-- Trust user-installed CAs too, so a homelab Nextcloud with its own certificate authority works
     (install the CA in Android Settings > Security > Encryption & credentials). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
